<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Authors>yomishino</Authors>
    <Version>2.1.0.0</Version>
    <Description>A FFXIV Dalamud plugin that provides a visual cue on the effect range of the AoE action just used.</Description>
    <PackageProjectUrl>https://github.com/yomishino/FFXIVActionEffectRange</PackageProjectUrl>
    <Configurations>Debug;Release;TestRelease</Configurations>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'TestRelease'">
    <DefineConstants>$(DefineConstants);TRACE;TEST</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>

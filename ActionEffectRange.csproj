<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Authors>yomishino, Valgrifer</Authors>
    <Version>2.1.0.0</Version>
    <Description>A FFXIV Dalamud plugin that provides a visual cue on the effect range of the AoE action just used.</Description>
    <PackageProjectUrl>https://github.com/Valgrifer/FFXIVActionEffectRange</PackageProjectUrl>
    <Configurations>Debug;Release;TestRelease</Configurations>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KamiToolKit" Version="3.0.12" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- KamiToolKit loads its textures (colour picker...) from <plugin dir>/Assets -->
  <ItemGroup>
    <None Include="$(PkgKamiToolKit)/contentFiles/any/*/Assets/*.png"
          Link="Assets/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'TestRelease'">
    <DefineConstants>$(DefineConstants);TRACE;TEST</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
